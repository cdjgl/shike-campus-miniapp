/* 页面容器 */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 30rpx;
}

/* ===== 筛选区 ===== */
.filter-card {
  margin: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.filter-row {
  display: flex;
  align-items: center;
}
.filter-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  width: 100rpx;
  flex-shrink: 0;
}
.filter-select {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}
.select-text {
  font-size: 28rpx;
  color: #333;
}
.select-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 下拉列表 */
.dropdown {
  margin-top: 8rpx;
  margin-left: 100rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  overflow: hidden;
}
.dropdown-option {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}
.dropdown-option:last-child {
  border-bottom: none;
}
.dropdown-option.active {
  color: #367BFF;
  background: #f0f6ff;
  font-weight: 600;
}

/* 查询按钮 */
.query-btn {
  margin-top: 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #367BFF 0%, #5A9CFF 100%);
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(54,123,255,0.3);
}
.query-btn:active {
  opacity: 0.85;
}
.query-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 结果区 ===== */
.result-area {
  padding: 0 24rpx;
}
.result-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 8rpx 16rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.result-count {
  font-size: 24rpx;
  color: #999;
}

/* 考试卡片 */
.exam-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-stripe {
  width: 8rpx;
  flex-shrink: 0;
}
.stripe-upcoming { background: #ff976a; }
.stripe-done      { background: #999; }
.card-body {
  flex: 1;
  padding: 24rpx;
}

/* 第一行：课程名 + 状态 */
.card-row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.tag-upcoming { color: #ff976a; background: rgba(255,151,106,0.1); }
.tag-done     { color: #999;     background: rgba(153,153,153,0.1); }

/* 第二行：考试名称 */
.card-row2 {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}
.exam-name-label {
  font-size: 22rpx;
  color: #b0b0b0;
  width: 120rpx;
  flex-shrink: 0;
}
.exam-name-value {
  font-size: 26rpx;
  color: #555;
  line-height: 1.4;
  flex: 1;
}

/* 第三行/第四行：时间和地点 */
.card-row3, .card-row4 {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.card-row4 {
  margin-bottom: 0;
}
.info-label {
  font-size: 22rpx;
  color: #b0b0b0;
  width: 120rpx;
  flex-shrink: 0;
}
.info-text {
  font-size: 26rpx;
  color: #555;
}
.time-text {
  color: #333;
  font-weight: 500;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 引导区 */
.guide {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}
.guide-text {
  font-size: 28rpx;
  color: #bbb;
  text-align: center;
}
