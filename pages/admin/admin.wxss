.admin-container {
  min-height: 100vh;
  background: #f2f4f8;
  padding-bottom: 40rpx;
}

.tab-scroll {
  background: #367BFF;
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  padding: 0 10rpx;
}

.tab-item {
  display: inline-block;
  padding: 26rpx 22rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tab-item.active {
  color: #fff;
  border-bottom: 4rpx solid #fff;
  font-weight: 600;
}

.section {
  padding: 24rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-pub {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.badge-normal {
  background: #e6f0ff;
  color: #367BFF;
}

.badge-removed {
  background: #ffe3e3;
  color: #e74c3c;
}

.card-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.card-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.op {
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #f2f4f8;
  color: #333;
  margin-left: 16rpx;
}

.op-danger {
  background: #ffe3e3;
  color: #e74c3c;
}

.op-primary {
  background: #367BFF;
  color: #fff;
}

.form-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.f-input {
  border-bottom: 1rpx solid #e8e8e8;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.f-area {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}

.sub-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat-box {
  width: 31%;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  text-align: center;
}

.s-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #367BFF;
}

.s-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
