.login-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.header-section {
  padding: 120rpx 0 60rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
}

.input-group {
  position: relative;
  margin-bottom: 30rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  transition: border-color 0.3s ease;
}

.input-wrapper.focused {
  border-color: #367BFF;
}

.input-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.input-field::placeholder {
  color: #999;
}

.password-toggle {
  font-size: 36rpx;
}

.agreement-section {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

.agreement-text {
  color: #666;
}

.agreement-link {
  color: #367BFF;
}

.login-button {
  width: 100%;
  background: #367BFF;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.login-button[disabled] {
  background: #ccc;
}

.login-button:active {
  opacity: 0.8;
}

.links-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.register-link {
  font-size: 26rpx;
  color: #367BFF;
}

.forget-password {
  font-size: 26rpx;
  color: #367BFF;
}
