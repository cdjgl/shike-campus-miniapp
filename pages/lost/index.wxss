/* ==================== 容器 ==================== */
.lost-container{min-height:100vh;background:#f5f6fa}

/* ==================== 主Tab栏 ==================== */
.main-tabs{display:flex;background:#fff;border-bottom:1rpx solid #eee;position:sticky;top:0;z-index:99}
.tab-item{flex:1;text-align:center;padding:26rpx 0;font-size:28rpx;color:#666;position:relative}
.tab-item:active{background:#f8f8f8}
.tab-item.active{color:#367BFF;font-weight:700}
.tab-item.active::after{
  content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);
  width:48rpx;height:6rpx;background:#367BFF;border-radius:3rpx
}

/* ==================== 搜索栏 ==================== */
.filter-bar{padding:20rpx 24rpx;background:#fff}
.search-box{
  display:flex;align-items:center;background:#f5f6fa;
  border-radius:36rpx;padding:14rpx 24rpx;gap:10rpx
}
.search-input{flex:1;font-size:26rpx;line-height:1.4}

/* ==================== 类型筛选标签 ==================== */
.type-scroll{white-space:nowrap;background:#fff;padding-bottom:16rpx}
.type-tags{display:inline-flex;padding:0 24rpx;gap:16rpx}
.type-tag{
  display:inline-block;font-size:24rpx;color:#666;background:#f0f1f5;
  border-radius:28rpx;padding:12rpx 26rpx;white-space:nowrap;transition:.2s
}
.type-tag:active{transform:scale(.94)}
.type-tag.active{color:#fff;background:#367BFF}

/* ==================== 统计 ==================== */
.list-count{font-size:22rpx;color:#bbb;padding:10rpx 24rpx;background:#fff}
.empty-wrap{padding:80rpx 24rpx}

/* ==================== 列表滚动区 ==================== */
.item-list{padding:16rpx 24rpx;display:flex;flex-direction:column;gap:18rpx}

/* ==================== 卡片 ==================== */
.item-card{
  background:#fff;border-radius:18rpx;padding:24rpx;
  box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);transition:transform .15s
}
.item-card:active{transform:scale(.98)}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}
.card-title-row{display:flex;align-items:center;gap:12rpx}
.card-name{font-size:31rpx;font-weight:700;color:#222}
.card-header-right{display:flex;align-items:center;gap:14rpx}
.card-type-tag{
  font-size:21rpx;color:#367BFF;background:#eef4ff;
  padding:4rpx 14rpx;border-radius:8rpx
}
.del-btn{padding:6rpx}
.del-btn:active{opacity:.4}
.card-body{margin-bottom:16rpx}
.info-row{display:flex;margin-bottom:10rpx}
.info-label{font-size:23rpx;color:#aaa;width:72rpx;flex-shrink:0}
.info-val{font-size:25rpx;color:#555;flex:1;line-height:1.55}
.info-val.desc{color:#777}
.img-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}
.thumb-img{width:140rpx;height:140rpx;border-radius:12rpx;background:#f0f0f0}
.card-footer{
  display:flex;justify-content:space-between;align-items:center;
  padding-top:16rpx;border-top:1rpx solid #f3f3f3
}
.footer-left{display:flex;align-items:center;gap:14rpx}
.pub-name{font-size:23rpx;color:#666}
.pub-time{font-size:21rpx;color:#ccc}
.footer-right{display:flex;gap:28rpx}
.fbtn{display:flex;align-items:center;gap:6rpx;padding:8rpx 14rpx}
.fbtn:active{opacity:.5}
.fbtn text{font-size:23rpx;color:#999}
.chat-fbtn text{color:#367BFF;font-weight:500}

/* ==================== 发布页 ==================== */
.publish-scroll{height:calc(100vh - 90rpx)}
.publish-form{background:#fff;margin:20rpx 24rpx;border-radius:18rpx;padding:10rpx 0}

/* --- 类型切换 --- */
.type-switch-bar{
  display:flex;align-items:center;justify-content:center;margin:20rpx 28rpx;
  background:#f5f6fa;border-radius:40rpx;padding:8rpx;position:relative
}
.sw-item{
  flex:1;text-align:center;padding:16rpx 0;font-size:28rpx;
  color:#888;border-radius:36rpx;font-weight:500;transition:.25s;z-index:1
}
.sw-item:active{opacity:.6}
.sw-active-lost{color:#fff;background:linear-gradient(135deg,#ff6b6b,#ee5a5a)}
.sw-active-found{color:#fff;background:linear-gradient(135deg,#51cf66,#37b24d)}
.sw-divider{width:1rpx;height:36rpx;background:#ddd}

/* --- 表单行 --- */
.form-row{
  display:flex;align-items:center;padding:24rpx 28rpx;
  border-bottom:1rpx solid #f5f5f5
}
.form-col{flex-direction:column;align-items:flex-start !important;gap:16rpx}
.form-label{font-size:28rpx;color:#333;width:150rpx;flex-shrink:0;font-weight:500}
.form-input{flex:1;font-size:26rpx;color:#333;text-align:right}
.form-pick{
  flex:1;display:flex;justify-content:flex-end;align-items:center;gap:8rpx
}
.pick-val{font-size:26rpx;color:#333}
.pick-placeholder{font-size:26rpx;color:#bbb}
.form-area{
  width:100%;min-height:160rpx;font-size:26rpx;color:#333;line-height:1.65;
  padding:16rpx;background:#fafafa;border-radius:12rpx;box-sizing:border-box
}
.area-count{align-self:flex-end;font-size:22rpx;color:#ccc}
.form-btns{padding:30rpx 28rpx 40rpx}

/* ==================== 类型选择器 ==================== */
.picker-wrap{padding-bottom:env(safe-area-inset-bottom)}
.picker-head{
  display:flex;justify-content:space-between;align-items:center;
  padding:28rpx 28rpx 20rpx;border-bottom:1rpx solid #eee
}
.picker-title{font-size:32rpx;font-weight:700;color:#333}
.picker-grid{
  display:flex;flex-wrap:wrap;padding:24rpx 28rpx 48rpx;gap:18rpx
}
.pgrid-item{
  font-size:26rpx;color:#555;background:#f5f6fa;padding:18rpx 32rpx;
  border-radius:32rpx;transition:.2s
}
.pgrid-item:active{transform:scale(.92)}
.pgrid-sel{color:#fff;background:#367BFF}

/* ==================== 详情弹窗 ==================== */
.detail-wrap{display:flex;flex-direction:column;height:100%}
.detail-top{
  display:flex;justify-content:space-between;align-items:center;
  padding:28rpx 28rpx 18rpx;border-bottom:1rpx solid #eee
}
.d-title{font-size:36rpx;font-weight:800;color:#222;flex:1;margin-right:16rpx}
.d-meta{
  display:flex;align-items:center;gap:14rpx;padding:16rpx 28rpx;border-bottom:1rpx solid #f5f5f5
}
.d-meta-type{font-size:22rpx;color:#367BFF;background:#eef4ff;padding:4rpx 14rpx;border-radius:8rpx}
.d-time{font-size:22rpx;color:#ccc;margin-left:auto}
.d-body{flex:1;overflow-y:hidden;padding:20rpx 28rpx}
.d-sec{margin-bottom:22rpx}
.d-sec-lbl{font-size:23rpx;color:#aaa;display:block;margin-bottom:6rpx}
.d-sec-val{font-size:28rpx;color:#444;line-height:1.65}
.d-desc{color:#666}
.d-imgs{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}
.d-img{width:200rpx;height:200rpx;border-radius:14rpx;background:#f0f0f0}
.d-pub-info{
  display:flex;align-items:center;gap:8rpx;padding:20rpx 0;border-top:1rpx solid #f5f5f5;
  font-size:25rpx;color:#888
}
.d-pub-name{color:#367BFF;font-weight:600}
.d-contact{
  margin-left:16rpx;font-size:23rpx;color:#27ae60;
  background:#edfff3;padding:4rpx 14rpx;border-radius:8rpx
}
.d-actions{
  display:flex;align-items:center;justify-content:space-around;
  padding:24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee
}
.d-abtn{
  display:flex;flex-direction:column;align-items:center;gap:6rpx;
  padding:14rpx 24rpx;border-radius:14rpx
}
.d-abtn:active{background:#f5f5f5}
.d-abtn text{font-size:22rpx}
.cta-abtn{
  background:linear-gradient(135deg,#367BFF,#589bff);
  border-radius:36rpx !important;padding:18rpx 44rpx !important;gap:10rpx
}

/* ==================== 评论弹窗 ==================== */
.cmt-wrap{display:flex;flex-direction:column;height:100%;overflow:hidden}
.cmt-head{
  display:flex;justify-content:space-between;align-items:center;
  padding:28rpx 28rpx 18rpx;font-size:32rpx;font-weight:700;color:#333;
  border-bottom:1rpx solid #eee;flex-shrink:0
}
.cmt-brief{
  padding:16rpx 28rpx;background:#fafafa;border-bottom:1rpx solid #f0f0f0;flex-shrink:0
}
.cmt-brief-name{font-size:27rpx;font-weight:600;color:#333;display:block;margin-bottom:4rpx}
.cmt-brief-loc{font-size:22rpx;color:#aaa}

/* 评论列表 —— 固定不左右滑动 */
.cmt-list{flex:1;padding:16rpx 28rpx;overflow-x:hidden;width:100%;box-sizing:border-box}
.cmt-empty{
  display:flex;justify-content:center;align-items:center;
  height:200rpx;font-size:26rpx;color:#bbb
}

/* 评论左滑删除 —— 对齐 news/detail 方案 */
.cmt-swipe-wrap{position:relative;overflow:hidden}
.cmt-swipe-inner{
  display:flex;gap:16rpx;padding:20rpx 0;
  border-bottom:1rpx solid #f5f5f5;
  position:relative;transition:transform .2s ease-out
}
.cmt-swipe-content{
  display:flex;gap:16rpx;flex:1;min-width:0
}
.cmt-del-btn{
  position:absolute;left:100%;top:0;bottom:0;
  width:140rpx;background:#e74c3c;color:#fff;
  display:flex;align-items:center;justify-content:center;
  font-size:26rpx;border-radius:8rpx
}
.cmt-del-btn:active{opacity:.8}
.cmt-item{display:flex;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #f5f5f5;width:100%;box-sizing:border-box}
.cmt-avatar{
  width:64rpx;height:64rpx;border-radius:50%;
  background:#f8f8f8;display:flex;align-items:center;justify-content:center;flex-shrink:0
}
.cmt-body{flex:1;min-width:0;overflow:hidden;word-break:break-all}
.cmt-item-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}
.cmt-user{font-size:26rpx;color:#367BFF;font-weight:600}
.cmt-cmtime{font-size:20rpx;color:#ccc}
.cmt-txt{font-size:26rpx;color:#555;line-height:1.65;word-break:break-all}

/* 评论中的图片 */
.cmt-imgs{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.cmt-thumb{width:130rpx;height:130rpx;border-radius:10rpx;background:#f0f0f0}

/* 评论待发送图片预览 */
.cmt-img-pre{display:flex;gap:10rpx;padding:0 28rpx 12rpx;flex-shrink:0}
.cmt-pre-item{position:relative;width:80rpx;height:80rpx}
.cmt-pre-img{width:100%;height:100%;border-radius:10rpx}
.cmt-pre-del{
  position:absolute;top:-8rpx;right:-8rpx;
  width:34rpx;height:34rpx;border-radius:50%;background:#e74c3c;
  display:flex;align-items:center;justify-content:center
}

/* 评论输入区 */
.cmt-input-area{flex-shrink:0;border-top:1rpx solid #eee;background:#fff}
.cmt-tools{display:flex;gap:0;padding:10rpx 20rpx 4rpx}
.cmt-tool-btn{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx}
.cmt-tool-btn:active{background:#f0f0f0}
.cmt-input-row{
  display:flex;align-items:center;gap:16rpx;
  padding:12rpx 20rpx calc(20rpx + env(safe-area-inset-bottom))
}
.cmt-input{
  flex:1;height:68rpx;background:#f5f6fa;border-radius:34rpx;
  padding:0 26rpx;font-size:26rpx
}

/* ==================== 表情选择面板 ==================== */
.emoji-panel{
  background:#fff;border-top:1rpx solid #eee;
  padding-bottom:env(safe-area-inset-bottom);flex-shrink:0
}
.emoji-header{
  display:flex;justify-content:space-between;align-items:center;
  padding:16rpx 28rpx;border-bottom:1rpx solid #f5f5f5;
  font-size:26rpx;color:#666
}
.emoji-grid{
  display:flex;flex-wrap:wrap;padding:16rpx 12rpx;overflow-x:hidden;overflow-y:auto;max-height:260rpx
}
.emoji-item{
  width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;
  font-size:44rpx;border-radius:12rpx
}
.emoji-item:active{background:#f0f0f0;transform:scale(1.15)}
