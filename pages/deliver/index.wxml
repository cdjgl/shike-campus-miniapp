<scroll-view scroll-y class="deliver-page">

  <!-- 已通过状态 -->
  <view class="status-card" wx:if="{{ approved }}">
    <view class="status-icon-wrap approved-bg">
      <van-icon name="passed" size="80rpx" color="#fff" />
    </view>
    <text class="status-title">已通过审核</text>
    <text class="status-sub">您现在可以接单了！</text>
    <view class="approved-services">
      <view
        wx:for="{{ applicationInfo.serviceNames }}"
        wx:key="*this"
        class="approved-tag"
      >
        <text>{{ item }}</text>
      </view>
    </view>
    <view class="status-info-row">
      <text>校区：{{ applicationInfo.campus }}</text>
      <text>时间：{{ applicationInfo.availableTimes.join('、') }}</text>
    </view>
  </view>

  <!-- 待审核状态 -->
  <view class="status-card" wx:elif="{{ applied && !approved }}">
    <view class="status-icon-wrap pending-bg">
      <van-icon name="clock-o" size="80rpx" color="#fff" />
    </view>
    <text class="status-title">审核中</text>
    <text class="status-sub">您的申请正在审核中，通常1-3个工作日内完成</text>
    <view class="status-info-row">
      <text>提交时间：{{ applicationInfo.submitTime }}</text>
    </view>
    <button class="reapply-btn disabled-btn">等待审核</button>
  </view>

  <!-- 未申请：表单 -->
  <block wx:if="{{ !applied }}">

    <!-- 头部说明 -->
    <view class="intro-card">
      <view class="intro-header">
        <van-icon name="friends-o" size="48rpx" color="#e67e22" />
        <text class="intro-title">成为接单员</text>
      </view>
      <text class="intro-desc">成为拾刻校园通的认证接单员，利用空闲时间赚取零花钱。支持快递代取、跑腿、清洗、打印等多种服务。</text>
      <view class="intro-benefits">
        <view class="benefit-item">
          <van-icon name="gold-coin-o" size="36rpx" color="#f39c12" />
          <text>灵活接单，按劳分配</text>
        </view>
        <view class="benefit-item">
          <van-icon name="shield-o" size="36rpx" color="#367BFF" />
          <text>平台担保，安全可靠</text>
        </view>
        <view class="benefit-item">
          <van-icon name="clock-o" size="36rpx" color="#5cb85c" />
          <text>随时提现，秒到账</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section">
      <view class="section-title">
        <view class="title-dot" style="background:#367BFF;"></view>
        <text>基本信息</text>
      </view>

      <view class="form-item">
        <text class="form-label">真实姓名</text>
        <input
          class="form-input"
          value="{{ realName }}"
          placeholder="请输入真实姓名"
          maxlength="20"
          bindinput="onNameInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">手机号码</text>
        <input
          class="form-input"
          value="{{ phone }}"
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">学号</text>
        <input
          class="form-input"
          value="{{ studentId }}"
          placeholder="请输入学号"
          maxlength="20"
          bindinput="onStudentIdInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">所在校区</text>
        <picker mode="selector" range="{{ campuses }}" value="{{ campusIndex }}" bindchange="onCampusChange">
          <view class="form-picker">
            <text class="{{ !campus ? 'placeholder' : '' }}">{{ campus || '选择所在校区' }}</text>
            <van-icon name="arrow" size="28rpx" color="#999" />
          </view>
        </picker>
      </view>
    </view>

    <!-- 服务类型（多选） -->
    <view class="section">
      <view class="section-title">
        <view class="title-dot" style="background:#e67e22;"></view>
        <text>选择服务类型</text>
        <text class="title-hint">可多选</text>
      </view>
      <view class="service-grid">
        <view
          wx:for="{{ serviceOptions }}"
          wx:key="key"
          class="service-option {{ isServiceSelected(item.key) ? 'service-selected' : '' }}"
          data-key="{{ item.key }}"
          bindtap="toggleService"
          style="{{ isServiceSelected(item.key) ? 'border-color:' + item.desc === '帮助同学取快递' ? '#367BFF' : (item.desc === '跑腿代办服务' ? '#5cb85c' : (item.desc === '衣物清洗配送' ? '#8e44ad' : '#e67e22')) + ';background:' + (item.desc === '帮助同学取快递' ? '#367BFF' : (item.desc === '跑腿代办服务' ? '#5cb85c' : (item.desc === '衣物清洗配送' ? '#8e44ad' : '#e67e22'))) + '08' : '' }}"
        >
          <view class="service-option-icon" style="background: {{ item.desc === '帮助同学取快递' ? '#367BFF15' : (item.desc === '跑腿代办服务' ? '#5cb85c15' : (item.desc === '衣物清洗配送' ? '#8e44ad15' : '#e67e2215')) }};">
            <van-icon name="{{ item.icon }}" size="44rpx" color="{{ item.desc === '帮助同学取快递' ? '#367BFF' : (item.desc === '跑腿代办服务' ? '#5cb85c' : (item.desc === '衣物清洗配送' ? '#8e44ad' : '#e67e22')) }}" />
          </view>
          <text class="service-option-name">{{ item.name }}</text>
          <text class="service-option-desc">{{ item.desc }}</text>
          <view wx:if="{{ isServiceSelected(item.key) }}" class="option-check">
            <van-icon name="success" size="24rpx" color="#fff" />
          </view>
        </view>
      </view>
    </view>

    <!-- 可接单时间 -->
    <view class="section">
      <view class="section-title">
        <view class="title-dot" style="background:#5cb85c;"></view>
        <text>可接单时间</text>
        <text class="title-hint">可多选</text>
      </view>
      <view class="time-grid">
        <view
          wx:for="{{ timeOptions }}"
          wx:key="*this"
          class="time-chip {{ isTimeSelected(item) ? 'time-selected' : '' }}"
          data-time="{{ item }}"
          bindtap="toggleTime"
        >
          <text>{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 自我介绍 -->
    <view class="section">
      <view class="section-title">
        <view class="title-dot" style="background:#8e44ad;"></view>
        <text>自我介绍</text>
        <text class="title-hint">选填</text>
      </view>
      <textarea
        class="intro-textarea"
        value="{{ selfIntro }}"
        placeholder="简单介绍一下自己，让发布者更信任你~（如：我有电动车、熟悉校园路线等）"
        maxlength="200"
        auto-height
        bindinput="onIntroInput"
      />
    </view>

    <!-- 同意规则 -->
    <view class="section agree-section">
      <view class="agree-row" bindtap="toggleAgree">
        <view class="checkbox-custom {{ agreeRules ? 'checked' : '' }}">
          <van-icon wx:if="{{ agreeRules }}" name="success" size="24rpx" color="#fff" />
        </view>
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" catchtap="viewRules">《接单规则》</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-deliver-btn" bindtap="submitApply">提交申请</button>
    </view>
    <view style="height: 140rpx;"></view>
  </block>

  <!-- 已申请但未通过时的操作区 -->
  <view wx:if="{{ applied && !approved }}" class="submit-section" style="margin-top:40rpx;">
    <button class="reapply-btn" bindtap="closeSuccessModal">返回首页</button>
  </view>
</scroll-view>

<!-- 成功弹窗 -->
<view class="success-modal" wx:if="{{ showSuccessModal }}">
  <view class="modal-mask" bindtap="closeSuccessModal"></view>
  <view class="success-content">
    <van-icon name="checked" size="100rpx" color="#e67e22" />
    <text class="success-title">申请提交成功</text>
    <text class="success-sub">我们将在1-3个工作日内审核您的申请</text>
    <text class="success-tip">您可以在「我的」页面查看审核进度</text>
    <button class="success-back" bindtap="closeSuccessModal">知道了</button>
  </view>
</view>
