.deliver-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 20rpx;
}

/* ========== 状态卡片 ========== */
.status-card {
  background: linear-gradient(135deg, #fff, #fef9f3);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.status-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.approved-bg { background: linear-gradient(135deg, #5cb85c, #36b37e); }
.pending-bg { background: linear-gradient(135deg, #f39c12, #f5a623); }
.status-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.status-sub { font-size: 27rpx; color: #999; text-align: center; line-height: 1.5; }

.approved-services {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
  margin-top: 28rpx;
  margin-bottom: 20rpx;
}
.approved-tag {
  font-size: 24rpx;
  color: #e67e22;
  background: #fef5ee;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-weight: 500;
}
.status-info-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #888;
}

.reapply-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #e67e22;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  margin-top: 32rpx;
}
.reapply-btn::after { border: none; }
.disabled-btn { background: #ccc; }

/* ========== 介绍卡片 ========== */
.intro-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
}
.intro-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.intro-title { font-size: 34rpx; font-weight: 700; color: #333; }
.intro-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.intro-benefits {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  color: #555;
}

/* ========== 通用分段 ========== */
.section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.title-dot {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #367BFF;
}
.section-title text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.title-hint {
  font-size: 22rpx !important;
  font-weight: 400 !important;
  color: #bbb !important;
  margin-left: auto;
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  margin-right: 24rpx;
  min-width: 160rpx;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.form-input::placeholder { color: #ccc; }
.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  font-size: 28rpx;
  color: #333;
}
.placeholder { color: #ccc; }

/* ========== 服务选项网格 ========== */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.service-option {
  width: calc(50% - 8rpx);
  padding: 24rpx 16rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  background: #fafafa;
}
.service-selected {
  border-color: #e67e22;
  background: #fef9f3;
}
.service-option-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.service-option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.service-option-desc {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
.option-check {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 0 0 0 38rpx;
  display: flex;
  align-items: flex-start;
  justify-content: end;
  padding: 4rpx 4rpx 0 0;
  box-sizing: border-box;
  background: #e67e22;
}

/* ========== 时间选择 ========== */
.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.time-chip {
  padding: 18rpx 30rpx;
  border: 2rpx solid #eee;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fafafa;
}
.time-selected {
  border-color: #5cb85c;
  background: #eeffee;
  color: #5cb85c;
  font-weight: 600;
}

/* ========== 自我介绍 ========== */
.intro-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 27rpx;
  color: #333;
  line-height: 1.6;
  background: #f8f9fc;
  padding: 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.intro-textarea::placeholder { color: #ccc; }

/* ========== 同意协议 ========== */
.agree-section { padding: 24rpx 28rpx; }
.agree-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.checkbox-custom {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #fff;
}
.checkbox-custom.checked { background: #e67e22; border-color: #e67e22; }
.agree-text { font-size: 26rpx; color: #666; }
.agree-link { font-size: 26rpx; color: #367BFF; font-weight: 600; }

/* ========== 提交按钮 ========== */
.submit-section {
  padding: 20rpx 48rpx;
}
.submit-deliver-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #e67e22, #d35400);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(230,126,34,0.35);
}
.submit-deliver-btn::after { border: none; }

/* ========== 成功弹窗 ========== */
.success-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.success-content {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.success-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  margin-top: 24rpx;
}
.success-sub {
  font-size: 27rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.5;
}
.success-tip {
  font-size: 25rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.success-back {
  width: 100%;
  margin-top: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #e67e22, #f39c12);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.success-back::after { border: none; }
