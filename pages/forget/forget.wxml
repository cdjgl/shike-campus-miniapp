<view class="forget-container">
  <view class="header-section">
    <text class="title">忘记密码</text>
    <text class="subtitle">请输入您绑定的手机号找回密码</text>
  </view>

  <view class="form-section">
    <view class="input-group">
      <view class="input-wrapper {{ phoneFocus ? 'focused' : '' }}">
        <input class="input-field" value="{{ phone }}" placeholder="请输入手机号" type="number" bindinput="onPhoneChange" bindfocus="onPhoneFocus" bindblur="onPhoneBlur" />
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrapper {{ codeFocus ? 'focused' : '' }}">
        <input class="input-field" value="{{ code }}" placeholder="请输入验证码" type="number" bindinput="onCodeChange" bindfocus="onCodeFocus" bindblur="onCodeBlur" />
        <button class="code-button {{ canGetCode ? 'active' : '' }}" disabled="{{ !canGetCode }}" bindtap="getCode">
          {{ codeText }}
        </button>
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrapper {{ passwordFocus ? 'focused' : '' }}">
        <input class="input-field" value="{{ password }}" type="password" placeholder="请输入新密码" bindinput="onPasswordChange" bindfocus="onPasswordFocus" bindblur="onPasswordBlur" />
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrapper {{ confirmFocus ? 'focused' : '' }}">
        <input class="input-field" value="{{ confirmPassword }}" type="password" placeholder="请确认新密码" bindinput="onConfirmChange" bindfocus="onConfirmFocus" bindblur="onConfirmBlur" />
      </view>
    </view>

    <button class="submit-button" disabled="{{ !canSubmit }}" bindtap="handleSubmit">
      确认重置
    </button>

    <view class="back-link" bindtap="goBack">返回登录</view>
  </view>
</view>
