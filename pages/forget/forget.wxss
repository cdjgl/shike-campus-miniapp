.forget-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.header-section {
  padding: 80rpx 0 40rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
}

.input-group {
  position: relative;
  margin-bottom: 30rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  transition: border-color 0.3s ease;
}

.input-wrapper.focused {
  border-color: #367BFF;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.input-field::placeholder {
  color: #999;
}

.code-button {
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
}

.code-button.active {
  background: #367BFF;
  color: white;
}

.code-button[disabled] {
  opacity: 0.5;
}

.submit-button {
  width: 100%;
  background: #367BFF;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.submit-button[disabled] {
  background: #ccc;
}

.submit-button:active {
  opacity: 0.8;
}

.back-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #367BFF;
}
