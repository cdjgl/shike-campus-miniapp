.order-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 20rpx;
}

/* ========== 通用分段 ========== */
.section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.title-dot {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #367BFF;
}
.section-title text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.title-hint {
  font-size: 22rpx !important;
  font-weight: 400 !important;
  color: #bbb !important;
  margin-left: auto;
}

/* ========== 规格卡片 ========== */
.spec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec-card {
  width: calc(33.33% - 11rpx);
  padding: 22rpx 12rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  background: #fafafa;
}
.spec-selected {
  border-color: #367BFF;
  background: #f0f6ff;
}
.spec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.spec-weight {
  font-size: 22rpx;
  color: #999;
}
.spec-volume {
  font-size: 20rpx;
  color: #bbb;
}
.spec-price {
  font-size: 26rpx;
  color: #e65454;
  font-weight: 600;
}
.spec-check {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 0 0 0 38rpx;
  background: #367BFF;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

/* ========== 快递包裹块 ========== */
.package-block {
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.pkg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.pkg-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #367BFF;
}
.pkg-del {
  font-size: 24rpx;
  color: #e74c3c;
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  margin-right: 24rpx;
  min-width: 140rpx;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.form-input::placeholder {
  color: #ccc;
}
.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  font-size: 28rpx;
  color: #333;
}
.placeholder {
  color: #ccc;
}

/* ========== 上传 ========== */
.upload-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  flex: 1;
}
.upload-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}
.upload-img image {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-btn {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #fafafa;
}
.upload-btn text {
  font-size: 20rpx;
  color: #bbb;
}

/* ========== 添加快递按钮 ========== */
.add-pkg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx;
  border: 2rpx dashed #367BFF;
  border-radius: 16rpx;
  color: #367BFF;
  font-size: 26rpx;
}

/* ========== 打赏标签 ========== */
.tip-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  flex: 1;
}
.tip-chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid #eee;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fafafa;
}
.tip-active {
  border-color: #f0ad4e;
  background: #fef8e8;
  color: #f0ad4e;
  font-weight: 600;
}

/* ========== 价格明细 ========== */
.price-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.price-label {
  font-size: 26rpx;
  color: #666;
}
.price-val {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.price-val.discount {
  color: #5cb85c;
}
.price-total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  margin-top: 8rpx;
}
.price-val.total {
  font-size: 38rpx;
  font-weight: 700;
  color: #e65454;
}

/* ========== 底部提交栏 ========== */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 50;
}
.submit-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.submit-price {
  font-size: 42rpx;
  font-weight: 700;
  color: #e65454;
}
.submit-count {
  font-size: 24rpx;
  color: #999;
}
.submit-btn {
  background: #367BFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 18rpx 56rpx;
  border-radius: 44rpx;
  border: none;
  line-height: 1.4;
}
.submit-btn::after { border: none; }

/* ========== 优惠券弹窗 ========== */
.coupon-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
}
.coupon-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 28rpx;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 28rpx;
}
.coupon-list {
  flex: 1;
  overflow-y: auto;
}
.coupon-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fafafa;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  position: relative;
}
.coupon-selected {
  border-color: #367BFF;
  background: #f0f6ff;
}
.coupon-disabled {
  opacity: 0.5;
}
.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 24rpx;
  border-right: 1rpx solid #eee;
  margin-right: 24rpx;
  min-width: 120rpx;
}
.coupon-value {
  font-size: 42rpx;
  font-weight: 700;
  color: #e65454;
}
.coupon-threshold {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.coupon-right {
  flex: 1;
}
.coupon-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.coupon-expire {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
  display: block;
}
.coupon-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #367BFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-btn {
  text-align: center;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #367BFF;
  border-top: 1rpx solid #f0f0f0;
}

/* ========== 支付成功弹窗 ========== */
.pay-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.pay-content {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pay-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-top: 20rpx;
}
.pay-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}
.pay-no {
  font-size: 28rpx;
  color: #367BFF;
  font-weight: 600;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  background: #f0f6ff;
  border-radius: 12rpx;
}
.pay-back {
  width: 100%;
  margin-top: 40rpx;
  height: 88rpx;
  background: #367BFF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  line-height: 88rpx;
}
.pay-back::after { border: none; }
.pay-continue {
  font-size: 28rpx;
  color: #999;
  margin-top: 24rpx;
  padding: 12rpx;
}
