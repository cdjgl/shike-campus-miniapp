<scroll-view scroll-y class="order-page">
  <!-- ========== 1. 包裹规格选择 ========== -->
  <view class="section">
    <view class="section-title">
      <view class="title-dot"></view>
      <text>包裹规格</text>
      <text class="title-hint">选择包裹大小自动匹配价格</text>
    </view>
    <view class="spec-grid">
      <view
        wx:for="{{ specs }}"
        wx:key="key"
        class="spec-card {{ selectedSpec === item.key ? 'spec-selected' : '' }}"
        data-key="{{ item.key }}"
        bindtap="selectSpec"
      >
        <text class="spec-name">{{ item.name }}</text>
        <text class="spec-weight">{{ item.weight }}</text>
        <text class="spec-volume">{{ item.volume }}</text>
        <view wx:if="{{ selectedSpec === item.key }}" class="spec-check">
          <van-icon name="success" size="24rpx" color="#fff" />
        </view>
        <text class="spec-price">{{ item.priceLabel }}</text>
      </view>
    </view>
  </view>

  <!-- ========== 2. 快递信息 ========== -->
  <view class="section">
    <view class="section-title">
      <view class="title-dot"></view>
      <text>快递信息</text>
    </view>

    <!-- 多包裹列表 -->
    <view wx:for="{{ packages }}" wx:key="idx" class="package-block">
      <view class="pkg-header">
        <text class="pkg-label">快递 {{ index + 1 }}</text>
        <text class="pkg-del" bindtap="removePackage" data-idx="{{ index }}" wx:if="{{ packages.length > 1 }}">删除</text>
      </view>

      <!-- 快递点 -->
      <view class="form-item">
        <text class="form-label">快递点</text>
        <picker mode="selector" range="{{ pickupPoints }}" value="{{ item.pickupIdx }}" bindchange="onPickupChange" data-idx="{{ index }}">
          <view class="form-picker">
            <text class="{{ item.pickupIdx === -1 ? 'placeholder' : '' }}">{{ item.pickupIdx === -1 ? '请选择快递点' : pickupPoints[item.pickupIdx] }}</text>
            <van-icon name="arrow" size="28rpx" color="#999" />
          </view>
        </picker>
      </view>

      <!-- 取件码 -->
      <view class="form-item">
        <text class="form-label">取件码</text>
        <input
          class="form-input"
          value="{{ item.pickupCode }}"
          placeholder="请输入取件码"
          data-idx="{{ index }}"
          data-field="pickupCode"
          bindinput="onPkgInput"
        />
      </view>

      <!-- 快递单号 -->
      <view class="form-item">
        <text class="form-label">快递单号</text>
        <input
          class="form-input"
          value="{{ item.trackingNo }}"
          placeholder="请输入快递单号（选填）"
          data-idx="{{ index }}"
          data-field="trackingNo"
          bindinput="onPkgInput"
        />
      </view>

      <!-- 截图上传 -->
      <view class="form-item">
        <text class="form-label">截图</text>
        <view class="upload-row">
          <view
            wx:for="{{ item.images }}"
            wx:key="idx"
            wx:for-index="imgIdx"
            class="upload-img"
          >
            <image src="{{ item.images[imgIdx] }}" mode="aspectFill" />
            <view class="img-del" bindtap="removeImage" data-pkg="{{ index }}" data-img="{{ imgIdx }}">
              <van-icon name="clear" size="28rpx" color="#fff" />
            </view>
          </view>
          <view class="upload-btn" bindtap="uploadImage" data-idx="{{ index }}" wx:if="{{ item.images.length < 3 }}">
            <van-icon name="photograph" size="44rpx" color="#bbb" />
            <text>上传截图</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 添加更多快递 -->
    <view class="add-pkg-btn" bindtap="addPackage" wx:if="{{ packages.length < 5 }}">
      <van-icon name="plus" size="32rpx" color="#367BFF" />
      <text>添加更多快递</text>
    </view>
  </view>

  <!-- ========== 3. 配送信息 ========== -->
  <view class="section">
    <view class="section-title">
      <view class="title-dot"></view>
      <text>配送信息</text>
    </view>

    <!-- 送达地址 -->
    <view class="form-item">
      <text class="form-label">送达地址</text>
      <input
        class="form-input"
        value="{{ deliveryAddr }}"
        placeholder="请填写宿舍楼栋+房间号"
        bindinput="onAddrInput"
      />
    </view>

    <!-- 预约送达时间 -->
    <view class="form-item">
      <text class="form-label">预约送达</text>
      <picker mode="multiSelector" range="{{ deliveryTimeRange }}" bindchange="onDeliveryTimeChange" bindcolumnchange="onTimeColumnChange">
        <view class="form-picker">
          <text class="{{ deliveryTimeText === '请选择' ? 'placeholder' : '' }}">{{ deliveryTimeText }}</text>
          <van-icon name="arrow" size="28rpx" color="#999" />
        </view>
      </picker>
    </view>

    <!-- 备注信息 -->
    <view class="form-item">
      <text class="form-label">备注</text>
      <input
        class="form-input"
        value="{{ remark }}"
        placeholder="特殊要求备注（选填）"
        bindinput="onRemarkInput"
      />
    </view>

    <!-- 追加打赏 -->
    <view class="form-item">
      <text class="form-label">打赏</text>
      <view class="tip-row">
        <view
          wx:for="{{ tips }}"
          wx:key="value"
          class="tip-chip {{ tipAmount === item.value ? 'tip-active' : '' }}"
          data-value="{{ item.value }}"
          bindtap="selectTip"
        >
          <text>{{ item.label }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 4. 优惠与结算 ========== -->
  <view class="section">
    <view class="section-title">
      <view class="title-dot"></view>
      <text>优惠与结算</text>
    </view>

    <!-- 优惠券 -->
    <view class="form-item">
      <text class="form-label">优惠券</text>
      <view class="form-picker" bindtap="selectCoupon">
        <text class="{{ selectedCoupon === -1 ? 'placeholder' : '' }}">{{ selectedCoupon === -1 ? '请选择优惠券' : coupons[selectedCoupon].label }}</text>
        <van-icon name="arrow" size="28rpx" color="#999" />
      </view>
    </view>

    <!-- 价格明细 -->
    <view class="price-detail">
      <view class="price-row">
        <text class="price-label">基础运费</text>
        <text class="price-val">¥{{ basePrice }}</text>
      </view>
      <view class="price-row" wx:if="{{ multiDiscount > 0 }}">
        <text class="price-label">多件折扣</text>
        <text class="price-val discount">-¥{{ multiDiscount }}</text>
      </view>
      <view class="price-row" wx:if="{{ tipAmount > 0 }}">
        <text class="price-label">打赏</text>
        <text class="price-val">+¥{{ tipAmount }}</text>
      </view>
      <view class="price-row" wx:if="{{ couponDiscount > 0 }}">
        <text class="price-label">优惠券</text>
        <text class="price-val discount">-¥{{ couponDiscount }}</text>
      </view>
      <view class="price-row price-total">
        <text class="price-label">合计</text>
        <text class="price-val total">¥{{ totalPrice }}</text>
      </view>
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <view class="submit-info">
      <text class="submit-price">¥{{ totalPrice }}</text>
      <text class="submit-count">共{{ packages.length }}件包裹</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>

  <view style="height: 140rpx;"></view>
</scroll-view>

<!-- 优惠券选择弹窗 -->
<view class="coupon-modal" wx:if="{{ showCouponModal }}">
  <view class="modal-mask" bindtap="closeCouponModal"></view>
  <view class="coupon-sheet">
    <view class="sheet-title">选择优惠券</view>
    <scroll-view scroll-y class="coupon-list">
      <view
        wx:for="{{ coupons }}"
        wx:key="id"
        class="coupon-item {{ selectedCoupon === index ? 'coupon-selected' : '' }} {{ item.disabled ? 'coupon-disabled' : '' }}"
        data-index="{{ index }}"
        bindtap="onCouponTap"
      >
        <view class="coupon-left">
          <text class="coupon-value">¥{{ item.value }}</text>
          <text class="coupon-threshold">满{{ item.threshold }}可用</text>
        </view>
        <view class="coupon-right">
          <text class="coupon-name">{{ item.label }}</text>
          <text class="coupon-expire">{{ item.expire }}</text>
        </view>
        <view wx:if="{{ selectedCoupon === index }}" class="coupon-check">
          <van-icon name="success" size="28rpx" color="#fff" />
        </view>
      </view>
    </scroll-view>
    <view class="sheet-btn" bindtap="closeCouponModal">确定</view>
  </view>
</view>

<!-- 支付成功提示（模拟） -->
<view class="pay-modal" wx:if="{{ showPayModal }}">
  <view class="modal-mask"></view>
  <view class="pay-content">
    <van-icon name="checked" size="100rpx" color="#5cb85c" />
    <text class="pay-title">下单成功</text>
    <text class="pay-sub">订单已提交，等待接单中</text>
    <text class="pay-no">订单号：{{ latestOrderNo }}</text>
    <button class="pay-back" bindtap="backToList">返回订单列表</button>
    <text class="pay-continue" bindtap="continueOrder">继续下单</text>
  </view>
</view>
