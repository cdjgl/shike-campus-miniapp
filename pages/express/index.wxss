/* ========== 校区选择弹窗 ========== */
.campus-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.modal-content {
  position: absolute;
  left: 40rpx; right: 40rpx;
  top: 50%;
  transform: translateY(-55%);
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 36rpx;
}
.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}
.modal-subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
}
.campus-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.campus-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 20rpx;
  background: #fafafa;
}
.campus-active {
  border-color: #367BFF;
  background: #f0f6ff;
}
.campus-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.campus-addr {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.modal-btn-wrap {
  margin-top: 40rpx;
}
.modal-confirm {
  width: 100%;
  height: 88rpx;
  background: #367BFF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  line-height: 88rpx;
}
.modal-confirm::after { border: none; }

/* ========== 主页面 ========== */
.express-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 140rpx;
}
.top-campus-bar {
  background: #fff;
  padding: 20rpx 28rpx;
}
.campus-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  background: #f0f6ff;
  border-radius: 36rpx;
}
.campus-label {
  font-size: 28rpx;
  color: #367BFF;
  font-weight: 600;
}

/* ========== 惩罚提示条 ========== */
.penalty-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #e74c3c, #f39c12);
}
.penalty-text {
  display: flex;
  flex-direction: column;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.penalty-sub {
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.85;
  margin-top: 2rpx;
}

/* ========== 功能入口 ========== */
.service-row {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 16rpx;
  background: #fff;
  margin-top: 2rpx;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.service-name {
  font-size: 22rpx;
  color: #666;
}

/* ========== 选项卡 ========== */
.tab-bar {
  display: flex;
  background: #fff;
  margin-top: 2rpx;
  padding: 0 16rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-active {
  color: #367BFF;
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #367BFF;
}
.tab-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* ========== 订单列表 ========== */
.order-list {
  padding: 20rpx 24rpx;
}
.order-swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  transition: transform 0.2s ease;
  position: relative;
  z-index: 1;
}
/* 锁定订单样式（未接单的他人订单） */
.order-locked {
  border-left: 6rpx solid #e0e0e0;
}
.order-locked .pkg-spec,
.order-locked .order-price {
  opacity: 1;
}
.order-locked .pkg-point,
.order-locked .order-addr {
  color: #bbb;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.order-no {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.order-id {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}
.order-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
.lock-tag {
  margin-left: 4rpx;
  display: flex;
  align-items: center;
}
.status-waiting { color: #f0ad4e; background: #fef8e8; }
.status-accepted { color: #367BFF; background: #f0f6ff; }
.status-done { color: #5cb85c; background: #eeffee; }
.status-cancel { color: #999; background: #f5f5f5; }
.status-delivering { color: #e67e22; background: #fef5ee; }
.order-time {
  font-size: 22rpx;
  color: #bbb;
}
.order-body {
  margin-bottom: 18rpx;
}
.order-pkg {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.pkg-spec {
  font-size: 26rpx;
  color: #333;
}
.pkg-point {
  font-size: 24rpx;
  color: #367BFF;
  background: #f0f6ff;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.order-addr {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 18rpx;
}
.footer-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.order-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #e65454;
}
.accept-tip {
  font-size: 22rpx;
  color: #fff;
  background: #367BFF;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.viewed-tag {
  font-size: 22rpx;
  color: #5cb85c;
  background: #eeffee;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.canceled-tag {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.action-btn {
  font-size: 24rpx;
  color: #367BFF;
  padding: 10rpx 24rpx;
  background: #f0f6ff;
  border-radius: 24rpx;
}

/* ========== 空列表 ========== */
.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 180rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #ccc;
  margin-top: 24rpx;
}

/* ========== 浮动下单按钮 ========== */
.float-btn {
  position: fixed;
  bottom: 48rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 36rpx;
  background: #367BFF;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 28rpx rgba(54,123,255,0.4);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 100;
}

/* ========== 左滑删除/取消接单 ========== */
.order-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #e74c3c;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  gap: 6rpx;
}
.order-cancel-accept {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 180rpx;
  background: #e67e22;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  gap: 6rpx;
}

/* ================================================
 *  接单确认 & 订单详情 弹窗（共用底部面板）
 *  ================================================ */
.accept-modal,
.detail-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 998;
}
.accept-sheet,
.detail-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 弹窗头部 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

/* 接单弹窗主体 */
.sheet-body {
  padding: 24rpx 36rpx;
}
.accept-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.accept-item:last-child {
  border-bottom: none;
}
.accept-label {
  font-size: 28rpx;
  color: #999;
}
.accept-value {
  font-size: 28rpx;
  color: #333;
  max-width: 60%;
  text-align: right;
}
.accept-price {
  color: #e65454;
  font-weight: 700;
  font-size: 32rpx;
}
.accept-note {
  margin: 16rpx 36rpx 0;
  padding: 20rpx 24rpx;
  background: #fef8e8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #c2802a;
}

/* 弹窗底部按钮 */
.sheet-footer {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 36rpx 36rpx;
}
.accept-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}
.accept-cancel::after { border: none; }
.accept-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #367BFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.accept-confirm::after { border: none; }

/* ========== 详情弹窗 ========== */
.detail-sheet {
  display: flex;
  flex-direction: column;
}
.detail-section {
  padding: 20rpx 36rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.detail-status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 2rpx solid #f0f0f0;
}
.detail-status-bar.status-waiting { color: #f0ad4e; }
.detail-status-bar.status-accepted { color: #367BFF; }
.detail-status-bar.status-delivering { color: #e67e22; }
.detail-status-bar.status-done { color: #5cb85c; }

.group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.detail-label {
  font-size: 26rpx;
  color: #999;
}
.detail-value {
  font-size: 26rpx;
  color: #333;
  max-width: 60%;
  text-align: right;
}
.pickup-code {
  color: #367BFF;
  font-weight: 700;
  font-size: 30rpx;
}
.addr-value {
  color: #333;
  font-weight: 500;
}
.price-value {
  color: #e65454;
  font-weight: 700;
  font-size: 32rpx;
}
.detail-total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 18rpx;
  margin-top: 6rpx;
}
/* 多包裹 */
.pack-block {
  padding: 6rpx 0;
}
.pack-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0 12rpx;
}
.pack-num {
  font-size: 24rpx;
  color: #367BFF;
  font-weight: 600;
  background: #f0f6ff;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

/* 详情底部关闭 */
.sheet-close-btn {
  padding: 20rpx 36rpx 36rpx;
}
.detail-close {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}
.detail-close::after { border: none; }

/* 详情弹窗操作按钮组 */
.detail-actions {
  display: flex;
  gap: 20rpx;
}
.detail-cancel-my {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx solid #e74c3c;
}
.detail-cancel-my::after { border: none; }
.detail-cancel-accept {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #e67e22;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx solid #e67e22;
}
.detail-cancel-accept::after { border: none; }
.detail-close-half {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
}
.detail-close-half::after { border: none; }
