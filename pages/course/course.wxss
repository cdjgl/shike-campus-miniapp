.course-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff5f7;
}

/* ========== 周次选择器 ========== */
.week-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: #fff;
  gap: 20rpx;
  position: relative;
}

.week-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-arrow:active {
  background: #eee;
}

.week-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
}

.week-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.week-today {
  position: absolute;
  right: 28rpx;
  padding: 10rpx 24rpx;
  background: #367BFF;
  border-radius: 30rpx;
}

.week-today text {
  font-size: 24rpx;
  color: #fff;
}

.week-today:active {
  opacity: 0.8;
}

/* ========== 日期表头 ========== */
.day-header {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-bottom: 1rpx solid #f0e8ec;
}

.dh-month {
  width: 90rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff8fa;
  padding: 8rpx 4rpx;
  gap: 2rpx;
}

.dh-month-num {
  font-size: 26rpx;
  color: #e65454;
  font-weight: 600;
}

.dh-semester {
  font-size: 18rpx;
  color: #999;
}

.dh-days {
  display: flex;
  flex: 1;
  width: 0; /* 让flex子项不溢出 */
}

.dh-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  position: relative;
}

.dh-today {
  background: #367BFF;
  border-radius: 16rpx;
}

.dh-today .dh-name,
.dh-today .dh-date {
  color: #fff !important;
}

.dh-name {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.dh-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.dh-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #367BFF;
  margin-top: 6rpx;
}

.dh-today .dh-dot {
  background: #fff;
}

/* ========== 课程表主体 ========== */
.table-body {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  background: #fff;
}

.table-grid {
  display: flex;
  min-height: 100%;
}

/* 左侧时段列 — 每大节 220rpx 高度 */
.period-col {
  width: 90rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #f0e8ec;
  background: #fafafa;
}

.period-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx dashed #eee;
  box-sizing: border-box;
  height: 220rpx; /* 每大节固定高度 */
}

.period-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.period-time {
  font-size: 16rpx;
  color: #bbb;
  line-height: 1.3;
  text-align: center;
}

/* 右侧课程区域 — 不滚动，等分7天 */
.course-area {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.course-canvas {
  display: flex;
  flex: 1;
  width: 100%;
}

.day-col {
  flex: 1;
  border-right: 1rpx solid #f5f0f2;
  position: relative;
  min-height: 1100rpx; /* 5大节 × 220rpx */
}

.day-col:last-child {
  border-right: none;
}

.course-slot {
  height: 180rpx;
  border-bottom: 1rpx solid #faf5f7;
  box-sizing: border-box;
}

/* ========== 课程卡片 — 长方形设计 ========== */
.course-card {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  border-radius: 10rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  box-shadow: 0 3rpx 14rpx rgba(0, 0, 0, 0.1);
  z-index: 3;
}

.cc-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
  line-height: 1.35;
  word-break: break-all;
}

.cc-teacher {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 2rpx;
  line-height: 1.3;
  word-break: break-all;
}

.cc-room {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.25;
  word-break: break-all;
}

.cc-week {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

/* ========== 底部班级标签 ========== */
.class-tag {
  padding: 12rpx 28rpx;
  background: #fff;
  border-top: 1rpx solid #f0e8ec;
  text-align: right;
}

.class-tag text {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
