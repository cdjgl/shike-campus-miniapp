<!-- 主页面 -->
<view class="errand-container">
  <!-- 功能入口 -->
  <view class="service-row">
    <view
      wx:for="{{ services }}"
      wx:key="key"
      class="service-item"
      data-key="{{ item.key }}"
      bindtap="onServiceTap"
    >
      <view class="service-icon" style="background: {{ item.bg }};">
        <van-icon name="{{ item.icon }}" size="44rpx" color="#fff" />
      </view>
      <text class="service-name">{{ item.name }}</text>
    </view>
  </view>

  <!-- 惩罚提示条 -->
  <view class="penalty-banner" wx:if="{{ penaltyInfo }}">
    <van-icon name="warning-o" size="32rpx" color="#fff" />
    <view class="penalty-text">
      <text>接单受限</text>
      <text class="penalty-sub">还剩 {{ penaltyInfo.remainMin }} 分钟解除</text>
    </view>
  </view>

  <!-- 分类选项卡 -->
  <view class="tab-bar">
    <view
      wx:for="{{ tabs }}"
      wx:key="key"
      class="tab-item {{ activeTab === item.key ? 'tab-active' : '' }}"
      data-key="{{ item.key }}"
      bindtap="switchTab"
    >
      <text>{{ item.label }}</text>
      <view wx:if="{{ item.badge > 0 }}" class="tab-badge">{{ item.badge }}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list" wx:if="{{ filteredOrders.length > 0 }}">
    <view
      wx:for="{{ filteredOrders }}"
      wx:key="id"
      class="order-swipe-wrap"
      data-id="{{ item.id }}"
    >
      <view
        class="order-card {{ item._swiping ? 'swiping' : '' }} {{ item._isLocked ? 'order-locked' : '' }}"
        style="transform: translateX({{ item._offsetX || 0 }}rpx);"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        data-id="{{ item.id }}"
        bindtap="onOrderTap"
      >
        <!-- 头部 -->
        <view class="order-header">
          <view class="order-no">
            <view class="cat-tag" style="background: {{ item.categoryColor }}15; color: {{ item.categoryColor }};">
              <van-icon name="{{ item.categoryIcon }}" size="24rpx" color="{{ item.categoryColor }}" />
            </view>
            <text class="order-id">#{{ item.orderNo }}</text>
            <text class="order-status {{ item.statusClass }}">{{ item.statusLabel }}</text>
            <view wx:if="{{ item._isLocked }}" class="lock-tag">
              <van-icon name="lock" size="22rpx" color="#999" />
            </view>
          </view>
          <text class="order-time">{{ item.createTime }}</text>
        </view>

        <!-- 任务内容 -->
        <view class="order-body">
          <text class="task-title">{{ item.taskTitle }}</text>
          <view class="route-row">
            <view class="route-dot start"></view>
            <text class="route-text">{{ item._displayStartAddr }}</text>
          </view>
          <view class="route-line"></view>
          <view class="route-row">
            <view class="route-dot end"></view>
            <text class="route-text">{{ item._displayEndAddr }}</text>
          </view>
        </view>

        <!-- 底部 -->
        <view class="order-footer">
          <view class="footer-left">
            <text class="order-price">¥{{ item.price }}</text>
            <text
              wx:if="{{ item.status === 'waiting' && item.owner !== 'me' && item._isLocked }}"
              class="accept-tip errand-accept-tip"
            >点击接单</text>
            <text wx:if="{{ item._canView && activeTab === 'received' }}" class="viewed-tag">已接单</text>
            <text wx:if="{{ item.owner === 'me' && item.status === 'cancel' }}" class="canceled-tag">已取消</text>
          </view>
          <view class="order-actions" wx:if="{{ activeTab === 'all' || activeTab === 'my' }}">
            <text class="action-btn" catchtap="onCopyOrder" data-id="{{ item.id }}">复制</text>
          </view>
        </view>
      </view>

      <!-- 左滑删除（自己的订单） -->
      <view
        wx:if="{{ item.owner === 'me' }}"
        class="order-delete"
        catchtap="onDeleteOrder"
        data-id="{{ item.id }}"
      >
        <van-icon name="delete-o" size="36rpx" color="#fff" />
        <text>删除</text>
      </view>

      <!-- 左滑取消接单（已接的他人订单） -->
      <view
        wx:if="{{ item.owner !== 'me' && item.status === 'accepted' && item._canView }}"
        class="order-cancel-accept"
        catchtap="onCancelAcceptedOrderSwipe"
        data-id="{{ item.id }}"
      >
        <van-icon name="close" size="36rpx" color="#fff" />
        <text>取消接单</text>
      </view>
    </view>
  </scroll-view>

  <view class="empty-list" wx:if="{{ filteredOrders.length === 0 }}">
    <van-icon name="orders-o" size="120rpx" color="#ddd" />
    <text class="empty-text">{{ emptyText }}</text>
  </view>
</view>

<!-- 浮动按钮 -->
<view class="float-btn" bindtap="goToOrder">
  <van-icon name="plus" size="40rpx" color="#fff" />
  <text>发布任务</text>
</view>


<!-- ==================== 接单确认弹窗 ==================== -->
<view class="accept-modal" wx:if="{{ showAcceptModal }}">
  <view class="modal-mask" bindtap="closeAcceptModal"></view>
  <view class="accept-sheet">
    <view class="sheet-header">
      <text class="sheet-title">确认接单</text>
      <van-icon name="cross" size="36rpx" color="#999" bindtap="closeAcceptModal" />
    </view>
    <view class="sheet-body">
      <view class="accept-item">
        <text class="accept-label">类型</text>
        <view class="cat-tag-sm" style="background: {{ acceptTarget.categoryColor }}15; color: {{ acceptTarget.categoryColor }};">
          <van-icon name="{{ acceptTarget.categoryIcon }}" size="26rpx" color="{{ acceptTarget.categoryColor }}" />
          <text>{{ acceptTarget.categoryName }}</text>
        </view>
      </view>
      <view class="accept-item">
        <text class="accept-label">任务标题</text>
        <text class="accept-value">{{ acceptTarget.taskTitle }}</text>
      </view>
      <view class="accept-item">
        <text class="accept-label">详细描述</text>
        <text class="accept-value desc-val">{{ acceptTarget.taskDetail || '无' }}</text>
      </view>
      <view class="accept-item">
        <text class="accept-label">起点</text>
        <text class="accept-value">{{ acceptTarget._displayStartAddr }}</text>
      </view>
      <view class="accept-item">
        <text class="accept-label">目的地</text>
        <text class="accept-value">{{ acceptTarget._displayEndAddr }}</text>
      </view>
      <view class="accept-item">
        <text class="accept-label">期望时间</text>
        <text class="accept-value">{{ acceptTarget.expectTime || '未指定' }}</text>
      </view>
      <view class="accept-item">
        <text class="accept-label">费用</text>
        <text class="accept-value accept-price">¥{{ acceptTarget.price }}</text>
      </view>
    </view>

    <view class="accept-note">
      <van-icon name="info-o" size="28rpx" color="#f0ad4e" />
      <text>接单后您将能看到完整地址和联系方式</text>
    </view>

    <view class="sheet-footer">
      <button class="accept-cancel" bindtap="closeAcceptModal">我再想想</button>
      <button class="accept-confirm" bindtap="confirmAccept">确认接单</button>
    </view>
  </view>
</view>


<!-- ==================== 订单详情弹窗 ==================== -->
<view class="detail-modal" wx:if="{{ showDetailModal }}">
  <view class="modal-mask" bindtap="closeDetailModal"></view>
  <view class="detail-sheet">
    <view class="sheet-header">
      <text class="sheet-title">跑腿详情</text>
      <van-icon name="cross" size="36rpx" color="#999" bindtap="closeDetailModal" />
    </view>

    <!-- 状态条 -->
    <view class="detail-status-bar {{ detailOrder.statusClass }}">
      <van-icon
        name="{{ detailOrder.status === 'waiting' ? 'clock-o' : (detailOrder.status === 'accepted' ? 'checked' : (detailOrder.status === 'done' ? 'passed' : 'logistics')) }}"
        size="40rpx"
      />
      <text>{{ detailOrder.statusLabel }}</text>
    </view>

    <!-- 基本信息 -->
    <view class="detail-section">
      <view class="detail-item">
        <text class="detail-label">订单编号</text>
        <text class="detail-value">#{{ detailOrder.orderNo }}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">服务类型</text>
        <view class="cat-tag-sm" style="background: {{ detailOrder.categoryColor }}15; color: {{ detailOrder.categoryColor }}; display:inline-flex; align-items:center; gap:6rpx; padding:6rpx 16rpx; border-radius:12rpx; font-size:24rpx;">
          <van-icon name="{{ detailOrder.categoryIcon }}" size="26rpx" color="{{ detailOrder.categoryColor }}" />
          <text>{{ detailOrder.categoryName }}</text>
        </view>
      </view>
    </view>

    <!-- 任务详情 -->
    <view class="detail-section">
      <view class="group-title">
        <van-icon name="todo-list-o" size="32rpx" color="#5cb85c" />
        <text>任务信息</text>
      </view>
      <view class="detail-item task-detail-block">
        <text class="task-detail-title">{{ detailOrder.taskTitle }}</text>
        <text class="task-detail-desc" wx:if="{{ detailOrder.taskDetail }}">{{ detailOrder.taskDetail }}</text>
      </view>
    </view>

    <!-- 路线信息（脱敏） -->
    <view class="detail-section">
      <view class="group-title">
        <van-icon name="guide" size="32rpx" color="#f0ad4e" />
        <text>路线</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">起点</text>
        <text class="detail-value route-val">{{ detailOrder._displayStartAddr }}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">目的地</text>
        <text class="detail-value route-val">{{ detailOrder._displayEndAddr }}</text>
      </view>
      <view class="detail-item" wx:if="{{ detailOrder.expectTime }}">
        <text class="detail-label">期望时间</text>
        <text class="detail-value">{{ detailOrder.expectTime }}</text>
      </view>
      <view class="detail-item" wx:if="{{ detailOrder.remark }}">
        <text class="detail-label">备注</text>
        <text class="detail-value">{{ detailOrder.remark }}</text>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="detail-section">
      <view class="group-title">
        <van-icon name="balance-o" size="32rpx" color="#e65454" />
        <text>费用</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">基础费用</text>
        <text class="detail-value">¥{{ detailOrder.basePrice || detailOrder.price }}</text>
      </view>
      <view class="detail-item" wx:if="{{ detailOrder.tipAmount > 0 }}">
        <text class="detail-label">打赏</text>
        <text class="detail-value">+¥{{ detailOrder.tipAmount }}</text>
      </view>
      <view class="detail-item detail-total">
        <text class="detail-label">合计</text>
        <text class="detail-value price-value">¥{{ detailOrder.price }}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="sheet-close-btn">
      <view wx:if="{{ detailOrder.owner === 'me' && (detailOrder.status === 'waiting' || detailOrder.status === 'accepted') }}" class="detail-actions">
        <button class="detail-cancel-my" bindtap="onCancelMyOrder">取消订单</button>
        <button class="detail-close-half" bindtap="closeDetailModal">关闭</button>
      </view>
      <view wx:elif="{{ detailOrder.owner !== 'me' && detailOrder.status === 'accepted' && detailOrder._canView }}" class="detail-actions">
        <button class="detail-cancel-accept" bindtap="onCancelAcceptedOrder">取消接单</button>
        <button class="detail-close-half" bindtap="closeDetailModal">关闭</button>
      </view>
      <view wx:else>
        <button class="detail-close" bindtap="closeDetailModal">关闭</button>
      </view>
    </view>
  </view>
</view>
