.club-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 搜索框 */
.club-search {
  background: #fff;
  padding: 16rpx 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 36rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
}

.search-placeholder {
  color: #c8c9cc;
  font-size: 28rpx;
}

/* 分类标签 */
.category-scroll {
  background: #fff;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
  flex-shrink: 0;
}

.category-active {
  background: #367BFF;
  color: #fff;
  font-weight: 600;
}

/* 社团卡片 */
.club-list {
  padding: 20rpx 24rpx;
}

.club-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
}

.club-card:active {
  transform: scale(0.98);
}

.club-card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.club-logo {
  width: 80rpx;
  height: 80rpx;
  background: rgba(54,123,255,0.08);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.club-info {
  flex: 1;
  min-width: 0;
}

.club-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.club-category {
  font-size: 22rpx;
  color: #999;
}

.join-btn {
  padding: 12rpx 28rpx;
  background: #367BFF;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.join-btn text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.join-btn.joined {
  background: #f0f0f0;
}

.join-btn.joined text {
  color: #999;
}

.club-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.club-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.club-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: rgba(54,123,255,0.06);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #367BFF;
}

.club-count {
  font-size: 22rpx;
  color: #aaa;
}

/* 空状态 */
.empty-club {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
  gap: 16rpx;
}
