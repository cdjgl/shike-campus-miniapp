.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部 */
.detail-header {
  background: linear-gradient(135deg, #367BFF 0%, #5b9bff 100%);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
}

.detail-logo {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.detail-category {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.detail-join {
  padding: 16rpx 36rpx;
  background: #fff;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.detail-join text {
  font-size: 26rpx;
  color: #367BFF;
  font-weight: 600;
}

.detail-join.joined {
  background: rgba(255,255,255,0.25);
}

.detail-join.joined text {
  color: #fff;
}

/* 基本信息卡片 */
.info-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
  margin-right: auto;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 标签 */
.tag-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx 8rpx;
  flex-wrap: wrap;
}

.dtag {
  padding: 8rpx 20rpx;
  background: rgba(54,123,255,0.08);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #367BFF;
}

/* 通用分区 */
.section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-title text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.section-content {
  padding: 0;
}

.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-line;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.activity-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #367BFF;
  flex-shrink: 0;
}

.activity-item text {
  font-size: 26rpx;
  color: #555;
}

/* 联系方式按钮 */
.contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 30rpx 24rpx;
  padding: 26rpx;
  background: linear-gradient(135deg, #367BFF, #5b9bff);
  border-radius: 16rpx;
}

.contact-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* 弹窗 */
.contact-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
}

.contact-dialog {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.contact-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.contact-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 36rpx;
  word-break: break-all;
}

.contact-close {
  padding: 18rpx;
  background: #367BFF;
  border-radius: 16rpx;
}

.contact-close text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.empty-detail {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  color: #999;
  font-size: 28rpx;
}
