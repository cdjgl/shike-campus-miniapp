  height: 4rpx;
  width: 26rpx;
  bottom: 24rpx;
}

.s-speechless .eye { height: 5rpx; border-radius: 0; }
.s-speechless .mouth {
  border-bottom: 0;
  border-top: 4rpx solid #6b4f12;
  border-radius: 0;
  height: 4rpx;
  width: 30rpx;
  bottom: 24rpx;
}

.s-wink .eye-r {
