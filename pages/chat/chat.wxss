.s-sleep { background: #C9D6EA; border-color: #9AAECB; }
.s-sleep .eye {
  background: transparent;
  border-bottom: 4rpx solid #4a5b73;
  height: 7rpx;
  border-radius: 0 0 14rpx 14rpx;
}
.s-sleep .mouth {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #4a5b73;
  border-radius: 50%;
  bottom: 20rpx;
}

.s-awkward { background: #FFE1A8; }
.s-awkward .mouth {
